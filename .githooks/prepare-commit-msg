#!/bin/sh

# Exit immediately for merge, squash, or amend commits — no mutation
case "$2" in
  merge|squash|commit) exit 0 ;;
esac

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

# Exit for detached HEAD, main, or master
case "$BRANCH" in
  ''|main|master) exit 0 ;;
esac

MSG=$(cat "$1")

# Exit for git's default revert subjects, so a revert keeps them unprefixed
case "$MSG" in
  'Revert "'*|'Reapply "'*) exit 0 ;;
esac

# Exit if the message holds `(…):` anywhere, taken as a type and scope already there
case "$MSG" in
  *\(*\):*) exit 0 ;;
esac

# Prefix on any branch that begins with a letter and holds a slash, taking the text around the first slash
case "$BRANCH" in
  [a-zA-Z]*/*)
    TYPE=${BRANCH%%/*}
    SCOPE=${BRANCH#*/}
    printf '%s(%s): %s' "$TYPE" "$SCOPE" "$MSG" > "$1"
    ;;
esac

exit 0
