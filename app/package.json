{
  "name": "gm-tool",
  "description": "A TTRGP session management tool",
  "author": "Simon Schötz",
  "private": true,
  "version": "0.18.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "node dev-data-server/runDevMirror.ts && tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "tauri build",
    "tauri": "tauri",
    "build:frontend": "vite build",
    "web": "vite --mode web",
    "web:seed": "GM_TOOL_WEB_DATA=seed vite --mode web",
    "dev:frontend": "vite",
    "preview": "vite preview",
    "test": "npx vitest run && npx tsc --noEmit && npx eslint . && npx prettier --check .",
    "test:coverage": "vitest --coverage",
    "prepare": "tsr generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/markdown": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/selection": "^0.53.0",
    "@lexical/table": "^0.53.0",
    "@tanstack/history": "1.162.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/router-core": "^1.171.39",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@types/node": "^26.6.6",
    "lexical": "^0.53.0",
    "lucide-react": "1.72.0",
    "nanoid": "^6.0.2",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "baseline-browser-mapping": "^2.11.36",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
