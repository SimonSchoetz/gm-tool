{
  "name": "gm-tool",
  "version": "1.0.0",
  "description": "Mono repo of the GM-Tool project",
  "homepage": "https://github.com/SimonSchoetz/gm-tool#readme",
  "bugs": {
    "url": "https://github.com/SimonSchoetz/gm-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimonSchoetz/gm-tool.git"
  },
  "author": "Simon Sch\u00f6tz",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "prepare": "simple-git-hooks",
    "test": "cd app && pnpm run test",
    "dev": "cd app && pnpm run dev",
    "web": "cd app && pnpm run web",
    "lint": "cd app && npx eslint .",
    "build-local": "cd app && pnpm run tauri build -- --debug",
    "create-release": "node scripts/create-release.ts",
    "prettier-fix": "cd app && npx prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "simple-git-hooks": "latest"
  },
  "simple-git-hooks": {
    "prepare-commit-msg": "./.githooks/prepare-commit-msg $1 $2"
  }
}
