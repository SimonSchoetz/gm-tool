{
  "name": "gm-tool",
  "version": "1.0.0",
  "description": "Mono repo of the GM-Tool project",
  "homepage": "https://github.com/SimonSchoetz/gm-tool#readme",
  "bugs": {
    "url": "https://github.com/SimonSchoetz/gm-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimonSchoetz/gm-tool.git"
  },
  "author": "Simon Sch\u00f6tz",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "prepare": "simple-git-hooks",
    "test": "cd app && pnpm run test",
    "dev": "cd app && pnpm run dev",
    "web": "cd app && pnpm run web",
    "web:seed": "cd app && pnpm run web:seed",
    "lint": "cd app && npx eslint .",
    "build-local": "cd app && pnpm run tauri build --debug --config src-tauri/tauri.dev.conf.json",
    "create-release": "node scripts/create-release.ts",
    "prettier-fix": "cd app && npx prettier --write .",
    "markdown-fix": "node scripts/markdown-fix.ts",
    "markdown-lint": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#_archive\" \"#app/src-tauri/target\" \"#app/src-tauri/vendor\" \"#.claude/worktrees\" \"#.claude/cycles\" \"#**/.stryker-tmp\"",
    "mutation-check": "node scripts/mutation-check.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "markdownlint-cli2": "0.23.3",
    "simple-git-hooks": "latest"
  },
  "simple-git-hooks": {
    "pre-commit": "./.githooks/staged-checks",
    "pre-merge-commit": "./.githooks/staged-checks",
    "prepare-commit-msg": "./.githooks/prepare-commit-msg $1 $2",
    "pre-push": "cd app && npx eslint . ../scripts && npx prettier --check . ../scripts && npx vitest run && cd src-tauri && cargo test"
  }
}
